# ═══════════════════════════════════════════════════════════
# SATHI NAVIGATION — BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════

# ── SERVER ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── POSTGRESQL + POSTGIS ─────────────────────────────────────
# Get from: Railway / Supabase / your local PostgreSQL
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sathi_db

# Alternatively, use individual fields:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sathi_db
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# ── REDIS ───────────────────────────────────────────────────
# Get from: Railway / Upstash (free tier) / local Redis
# Format:  redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=14400          # 4 hours cache TTL for route scores

# ── FIREBASE ────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
# Download the JSON and put the values here
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ── GOOGLE MAPS ─────────────────────────────────────────────
# Enable: Maps JavaScript API, Directions API, Places API, Geocoding API
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── TWILIO (SOS SMS ALERTS) ──────────────────────────────────
# Get from: twilio.com/console
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── EMAIL (SOS EMAIL FALLBACK) ────────────────────────────────
# Use Gmail with App Password or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password       # Gmail: Settings → Security → App Passwords

# ── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')" | pbcopy
JWT_SECRET=your_64_char_random_secret_here
JWT_EXPIRES_IN=7d

# ── PYTHON AI SERVICE ─────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100       # Per IP per window
